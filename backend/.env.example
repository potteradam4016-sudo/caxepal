# 개인용 .env 양식입니다. start.py가 복사본과 무작위 SECRET_KEY를 자동 생성합니다.
APP_ENV=development
SECRET_KEY=
HOST=127.0.0.1
PORT=3104
DATABASE_URL=sqlite:///./data/scnu_pick.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCS_ENABLED=true
SESSION_HOURS=24

FRONTEND_URL=http://localhost:5173

# 실제 받은 수집 허가의 출처·주기·조건을 저장소 기록과 맞춰 확인하세요.
# 확인한 허가 조건을 설정에 반영한 뒤에만 수집을 켭니다.
# 기본 실행에서는 수집하지 않으며 가짜 공지를 자동 삽입하지 않습니다.
CRAWL_ENABLED=false
AUTO_CRAWL=false
CRAWL_INTERVAL_SECONDS=10800
CRAWL_REQUEST_DELAY=1.0
CRAWL_TIMEOUT=15
CRAWL_USER_AGENT="SCNU-PICK/1.0 (university notice aggregation)"
ROBOTS_POLICY=strict

# rules는 규칙 분석이며 AI가 아닙니다. 외부 AI 제공자와 키 사용은 팀에서 결정합니다.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=

REQUEST_LIMIT_PER_MINUTE=120
AUTH_LIMIT_PER_15_MINUTES=10
MAX_REQUEST_BYTES=65536
